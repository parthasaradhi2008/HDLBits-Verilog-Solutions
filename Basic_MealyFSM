module top_module (
    input clk,
    input areset,
    input x,
    output z
);
    parameter a = 1'b0,b=1'b1;
    reg state, next_state;
    always @(posedge clk,posedge areset) begin
        if (areset)
            state <=a;
        else
            state <= next_state;
    end

    always @(*) begin
        case (state)
            a:next_state =x?b:a; 
            b:next_state =b;        
        endcase
    end
    assign z = (state == a) ? x : ~x;

endmodule
