module top_module(
    input clk,
    input reset,
    input ena,
    output reg pm,
    output reg [7:0] hh,
    output reg [7:0] mm,
    output reg [7:0] ss
);

    always @(posedge clk) begin
        if (reset) begin
            pm <= 1'b0;
            hh <= 8'h12; 
            mm <= 8'h00; 
            ss <= 8'h00;
        end else if (ena) begin
            if (ss == 8'h59) begin
                ss <= 8'h00;
                if (mm == 8'h59) begin
                    mm <= 8'h00;
                    if (hh == 8'h11) begin
                        pm <= ~pm;
                        hh <= 8'h12;
                    end else if (hh == 8'h12) begin
                        hh <= 8'h01;
                    end else if (hh[3:0] == 4'd9) begin
                        hh[7:4] <= hh[7:4] + 1'b1;
                        hh[3:0] <= 4'd0;
                    end else begin
                        hh[3:0] <= hh[3:0] + 1'b1;
                    end
                    
                end else begin
                    if (mm[3:0] == 4'd9) begin
                        mm[7:4] <= mm[7:4] + 1'b1;
                        mm[3:0] <= 4'd0;
                    end else begin
                        mm[3:0] <= mm[3:0] + 1'b1;
                    end
                end
                
            end else begin
                if (ss[3:0] == 4'd9) begin
                    ss[7:4] <= ss[7:4] + 1'b1;
                    ss[3:0] <= 4'd0;
                end else begin
                    ss[3:0] <= ss[3:0] + 1'b1;
                end
            end
        end
    end

endmodule
