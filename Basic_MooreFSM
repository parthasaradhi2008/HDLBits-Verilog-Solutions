module top_module (
    input clk,
    input areset,
    input x,
    output z
);
    parameter a = 2'd0,b=2'd1,c=2'd2;
    reg [1:0] state, next_state;
    always @(posedge clk or posedge areset) begin
        if (areset)
            state <=a;
        else
            state <= next_state;
    end 
    
    always @(*) begin
        case (state)
            a:next_state= x?b:a; 
            b:next_state =x?c:b; 
            c:next_state =x?c:b; 
            default: next_state = a;
        endcase
    end
    assign z =(state == b);

endmodule
