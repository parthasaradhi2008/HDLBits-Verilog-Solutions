module top_module(
    input clk,
    input areset,

    input  predict_valid,
    input  [6:0] predict_pc,
    output predict_taken,
    output [6:0] predict_history,

    input train_valid,
    input train_taken,
    input train_mispredicted,
    input [6:0] train_history,
    input [6:0] train_pc
);
    reg [6:0] history_register;
    reg [1:0] PHT[127:0];
    wire [6:0] predict_index;
    wire [6:0] train_index;
    assign predict_index=predict_pc^predict_history;
    assign train_index=train_pc^train_history;
    assign predict_history=history_register;
    assign predict_taken=PHT[predict_index][1];
    always @(posedge clk,posedge areset) begin
        if (areset) begin
            PHT<='{128{2'b01}};
            history_register<=7'd0;
        end else begin
            if (train_valid) begin
                if (train_taken) begin
                    if (PHT[train_index]<2'b11) PHT[train_index]<=PHT[train_index]+1;
                end
                else if (PHT[train_index]>2'b00) PHT[train_index]<=PHT[train_index]-1;
            end
            if (train_valid && train_mispredicted) history_register<={train_history[5:0],train_taken};
            else if (predict_valid) begin
                    history_register<={history_register[5:0],predict_taken};
            end
        end
    end
endmodule
